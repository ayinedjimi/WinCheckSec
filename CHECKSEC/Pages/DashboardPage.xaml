<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CHECKSEC.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CHECKSEC.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Spacing="20" Padding="12">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="28" Foreground="{StaticResource AccentBlueBrush}"/>
                    <StackPanel>
                        <TextBlock Text="WinCheckSec" Style="{StaticResource TitleTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Audit de sécurité et conformité Windows 11"
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                            <TextBlock Text="|" Opacity="0.3" VerticalAlignment="Center"/>
                            <TextBlock Text="Un outil AYI NEDJIMI CONSULTANTS"
                                       Style="{StaticResource CaptionTextBlockStyle}" 
                                       Foreground="{StaticResource AccentBlueBrush}" 
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <HyperlinkButton NavigateUri="https://ayinedjimi-consultants.fr" 
                                         Padding="0" Margin="0,2,0,0"
                                         ToolTipService.ToolTip="Visiter le site de AYI NEDJIMI CONSULTANTS">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE12B;" FontSize="12" Foreground="{StaticResource AccentBlueBrush}"/>
                                <TextBlock Text="ayinedjimi-consultants.fr" FontSize="12" Opacity="0.8"/>
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Command="{x:Bind ViewModel.AnalyzeCommand}" Margin="0,0,8,0"
                        Style="{StaticResource AccentButtonStyle}" Padding="16,10"
                        ToolTipService.ToolTip="Lancer une analyse complète de sécurité (Ctrl+L)"
                        AutomationProperties.Name="Lancer l'analyse de sécurité">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16"/>
                        <TextBlock Text="Lancer l'analyse" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Command="{x:Bind ViewModel.CancelCommand}" Margin="0,0,8,0"
                        Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}"
                        Padding="16,10" ToolTipService.ToolTip="Annuler l'analyse"
                        AutomationProperties.Name="Arrêter l'analyse en cours">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16"/>
                        <TextBlock Text="Arrêter"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Command="{x:Bind ViewModel.ExportCommand}" Padding="16,10"
                        Margin="0,0,8,0"
                        ToolTipService.ToolTip="Exporter le rapport d'analyse (Ctrl+E)"
                        AutomationProperties.Name="Exporter le rapport">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE78C;" FontSize="16"/>
                        <TextBlock Text="Exporter"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Click="OnGenerateHtmlReport" Padding="16,10"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                        ToolTipService.ToolTip="Générer un rapport HTML interactif"
                        AutomationProperties.Name="Exporter le rapport HTML">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE12B;" FontSize="16"/>
                        <TextBlock Text="HTML"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" Click="OnExportCef" Padding="16,10"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                        ToolTipService.ToolTip="Exporter au format CEF pour intégration SIEM"
                        AutomationProperties.Name="Exporter au format SIEM CEF">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE968;" FontSize="16"/>
                        <TextBlock Text="SIEM/CEF"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Progress section -->
            <InfoBar x:Name="ProgressBar"
                     IsOpen="{x:Bind ViewModel.ShowProgress, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Analyse en cours"
                     Message="{x:Bind ViewModel.StatusText, Mode=OneWay}">
                <InfoBar.Content>
                    <StackPanel Spacing="4">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                     Maximum="{x:Bind ViewModel.ProgressMax, Mode=OneWay}"
                                     Margin="0,0,0,4"/>
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.CurrentCollectorName, Mode=OneWay}"
                                       FontSize="12" Opacity="0.6" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}"
                                       FontSize="12" Opacity="0.6" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- Export indicator -->
            <InfoBar IsOpen="{x:Bind ViewModel.IsExporting, Mode=OneWay}"
                     IsClosable="False" Severity="Informational"
                     Title="Exportation en cours…">
                <InfoBar.Content>
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,8"/>
                </InfoBar.Content>
            </InfoBar>

            <!-- Empty state CTA -->
            <Border Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="48" HorizontalAlignment="Stretch" Margin="0,24,0,0">
                <StackPanel HorizontalAlignment="Center" Spacing="20">
                    <FontIcon Glyph="&#xE72E;" FontSize="72" Opacity="0.2" HorizontalAlignment="Center"
                              Foreground="{StaticResource AccentBlueBrush}"/>
                    <TextBlock Text="Prêt pour l'analyse" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Opacity="0.7"/>
                    <TextBlock Text="Lancez une analyse complète pour auditer la sécurité de votre système Windows 11."
                               HorizontalAlignment="Center" Opacity="0.4" TextWrapping="Wrap"
                               MaxWidth="450" TextAlignment="Center"/>
                    <Button Command="{x:Bind ViewModel.AnalyzeCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Padding="32,14" Margin="0,8,0,0"
                            AutomationProperties.Name="Lancer l'analyse de sécurité">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="18"/>
                            <TextBlock Text="Lancer l'analyse" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Score hero card -->
            <Border Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="130" Height="130" Margin="0,0,28,0">
                        <Ellipse Width="130" Height="130" StrokeThickness="4"
                                 Stroke="{StaticResource AccentBlueBrush}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.GlobalGrade, Mode=OneWay}"
                                       FontSize="52" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                            <TextBlock FontSize="14" HorizontalAlignment="Center" Opacity="0.7">
                                <Run Text="{x:Bind ViewModel.GlobalScore, Mode=OneWay}"/>
                                <Run Text="%"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
                        <TextBlock Text="Score de Sécurité Global" FontSize="22" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="32">
                            <Button Click="OnKpiClick" Tag="OK" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="8"
                                    ToolTipService.ToolTip="Nombre de vérifications conformes — cliquer pour voir le détail"
                                    AutomationProperties.Name="Voir les vérifications OK">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.TotalOK, Mode=OneWay}" FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource StatusGreenBrush}"/>
                                    <TextBlock Text="OK" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnKpiClick" Tag="Warning" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="8"
                                    ToolTipService.ToolTip="Points nécessitant une attention — cliquer pour voir le détail"
                                    AutomationProperties.Name="Voir les avertissements">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.TotalWarning, Mode=OneWay}" FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource StatusOrangeBrush}"/>
                                    <TextBlock Text="Avertissements" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnKpiClick" Tag="Critical" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="8"
                                    ToolTipService.ToolTip="Problèmes de sécurité critiques à corriger — cliquer pour voir le détail"
                                    AutomationProperties.Name="Voir les éléments critiques">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.TotalCritical, Mode=OneWay}" FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource StatusRedBrush}"/>
                                    <TextBlock Text="Critiques" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnKpiClick" Tag="Error" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="8"
                                    ToolTipService.ToolTip="Erreurs rencontrées lors de l'analyse — cliquer pour voir le détail"
                                    AutomationProperties.Name="Voir les erreurs">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.TotalError, Mode=OneWay}" FontSize="32" FontWeight="Bold"
                                               Opacity="0.4"/>
                                    <TextBlock Text="Erreurs" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Charts Section -->
            <Grid Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="24"
                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Répartition" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                        <controls:StatusDonutChart
                            ToolTipService.ToolTip="Répartition des résultats par statut (OK, Avertissement, Critique, Erreur)"
                            OkCount="{x:Bind ViewModel.TotalOK, Mode=OneWay}"
                            WarningCount="{x:Bind ViewModel.TotalWarning, Mode=OneWay}"
                            CriticalCount="{x:Bind ViewModel.TotalCritical, Mode=OneWay}"
                            ErrorCount="{x:Bind ViewModel.TotalError, Mode=OneWay}"/>
                        <!-- Legend -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource StatusGreenBrush}"/>
                                <TextBlock Text="OK" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource StatusOrangeBrush}"/>
                                <TextBlock Text="Avertissements" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource StatusRedBrush}"/>
                                <TextBlock Text="Critiques" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="Gray"/>
                                <TextBlock Text="Erreurs / N/A" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="24" Margin="12,0,0,0"
                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Scores par catégorie" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                        <controls:CategoryBarChart
                            ToolTipService.ToolTip="Score de conformité par catégorie de sécurité"
                            ItemsSource="{x:Bind ViewModel.CategoryScores, Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Category scores grid -->
            <StackPanel Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}" Spacing="12">
                <TextBlock Text="Scores par catégorie" FontSize="18" FontWeight="SemiBold"/>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.CategoryScores, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="300" MinItemHeight="90"
                                           MinColumnSpacing="12" MinRowSpacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="16" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Tapped="OnCategoryTapped"
                                    PointerEntered="OnCardPointerEntered"
                                    PointerExited="OnCardPointerExited">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Icon}" FontSize="24" VerticalAlignment="Center"
                                              Margin="0,0,14,0" Foreground="{StaticResource AccentBlueBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusGreenBrush}"/>
                                                <TextBlock Text="{Binding PassedChecks}" FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusOrangeBrush}"/>
                                                <TextBlock Text="{Binding WarningChecks}" FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusRedBrush}"/>
                                                <TextBlock Text="{Binding CriticalChecks}" FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Grade}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{Binding GradeColorHex, Converter={StaticResource HexToBrush}}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.5">
                                            <Run Text="{Binding ScorePercent}"/><Run Text="%"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Status bar -->
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.4" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
