<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CHECKSEC.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="12" MaxWidth="700" HorizontalAlignment="Left">
            <!-- Page header -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE946;" FontSize="28" Foreground="{StaticResource AccentBlueBrush}"/>
                <TextBlock Text="À propos" Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>

            <!-- App identity card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="28"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="&#xE72E;" FontSize="40" Foreground="{StaticResource AccentBlueBrush}"/>
                        <StackPanel>
                            <TextBlock Text="WinCheckSec" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind ViewModel.Author}" FontSize="14"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" FontSize="14">
                            <Run Text="Version "/>
                            <Run Text="{x:Bind ViewModel.Version}"/>
                        </TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.Description}" TextWrapping="Wrap"
                                   Opacity="0.8" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Keyboard shortcuts card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="28"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE765;" FontSize="18" Foreground="{StaticResource AccentBlueBrush}"/>
                        <TextBlock Text="Raccourcis clavier" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Navigation shortcuts -->
                    <TextBlock Text="Navigation" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <Grid RowSpacing="8" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Ctrl + 1" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Tableau de bord" FontSize="12"/>

                        <TextBlock Grid.Row="1" Text="Ctrl + 2" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Secure Core" FontSize="12"/>

                        <TextBlock Grid.Row="2" Text="Ctrl + 3" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Résultats Sécurité" FontSize="12"/>

                        <TextBlock Grid.Row="3" Text="Ctrl + 4" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Écarts MSCT" FontSize="12"/>

                        <TextBlock Grid.Row="4" Text="Ctrl + 5" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Benchmark CIS" FontSize="12"/>

                        <TextBlock Grid.Row="5" Text="Ctrl + 6" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Remédiation" FontSize="12"/>

                        <TextBlock Grid.Row="6" Text="Ctrl + 7" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Journaux d'événements" FontSize="12"/>

                        <TextBlock Grid.Row="7" Text="Ctrl + 8" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Informations système" FontSize="12"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,4"/>

                    <!-- Action shortcuts -->
                    <TextBlock Text="Actions" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <Grid RowSpacing="8" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Ctrl + L" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Lancer l'analyse" FontSize="12"/>

                        <TextBlock Grid.Row="1" Text="Ctrl + E" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Exporter le rapport" FontSize="12"/>

                        <TextBlock Grid.Row="2" Text="F5" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Actualiser / Relancer l'analyse" FontSize="12"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,4"/>

                    <!-- Search shortcut -->
                    <TextBlock Text="Recherche" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ctrl + F" FontFamily="Cascadia Mono" FontSize="12" Opacity="0.8"/>
                        <TextBlock Grid.Column="1" Text="Rechercher dans les résultats" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Disclaimer card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="28"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{StaticResource StatusOrangeBrush}"/>
                        <TextBlock Text="Avertissement" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Disclaimer}" TextWrapping="Wrap"
                               Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="© 2025 AYI NEDJIMI CONSULTANTS — Tous droits réservés"
                       Opacity="0.3" Style="{StaticResource CaptionTextBlockStyle}"
                       HorizontalAlignment="Center" Margin="0,8,0,16"/>
        </StackPanel>
    </ScrollViewer>
</Page>
