<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CHECKSEC.Pages.RemediationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.UI.Controls"
    NavigationCacheMode="Required"
    Loaded="OnLoaded">

    <Grid Padding="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE8FD;" FontSize="24" Foreground="{StaticResource AccentBlueBrush}"/>
                <TextBlock Text="Plan de Remédiation" Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OnExportExcel" ToolTipService.ToolTip="Exporter Excel"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}" Padding="12,8"
                        AutomationProperties.Name="Exporter au format Excel">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9F9;" FontSize="16"/>
                        <TextBlock Text="Excel" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Click="OnExportPdf" ToolTipService.ToolTip="Exporter PDF"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}" Padding="12,8"
                        AutomationProperties.Name="Exporter au format PDF">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEA90;" FontSize="16"/>
                        <TextBlock Text="PDF" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Click="OnCopyAll" ToolTipService.ToolTip="Copier tout"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}" Padding="12,8"
                        AutomationProperties.Name="Copier le plan de remédiation">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Copier" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                     VerticalAlignment="Top"/>

        <!-- Summary -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16,10"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="32">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TotalActions, Mode=OneWay}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Actions totales" FontSize="11" Opacity="0.6"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.CriticalActions, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource StatusRedBrush}"/>
                    <TextBlock Text="Critiques" FontSize="11" Opacity="0.6"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.QuickWins, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}"/>
                    <TextBlock Text="Quick Wins" FontSize="11" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="3" Text="Lancez une analyse pour générer le plan de remédiation."
                   Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToInverseVis}}"
                   Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>

        <!-- DataGrid -->
        <ctk:DataGrid Grid.Row="3"
                       x:Name="RemediationGrid"
                       ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                       AutoGenerateColumns="False"
                       CanUserSortColumns="True"
                       CanUserReorderColumns="False"
                       CanUserResizeColumns="True"
                       Sorting="OnSorting"
                       IsReadOnly="True"
                       GridLinesVisibility="Horizontal"
                       AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                       RowHeight="42"
                       MaxHeight="800"
                       HeadersVisibility="Column"
                       HorizontalScrollBarVisibility="Auto"
                       SelectionMode="Single"
                       Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">

            <ctk:DataGrid.Columns>
                <ctk:DataGridTextColumn Header="#" Binding="{Binding Priority}" Tag="Priority" Width="50"/>
                <ctk:DataGridTextColumn Header="Sévérité" Binding="{Binding Severity}" Tag="Severity" Width="80"/>
                <ctk:DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Tag="Category" Width="140"/>
                <ctk:DataGridTextColumn Header="Action" Binding="{Binding Action}" Tag="Action" Width="250"/>
                <ctk:DataGridTextColumn Header="Effort" Binding="{Binding Effort}" Tag="Effort" Width="90"/>
                <ctk:DataGridTextColumn Header="Commande / Remédiation" Binding="{Binding Command}" Tag="Command" Width="*"/>
            </ctk:DataGrid.Columns>
        </ctk:DataGrid>
    </Grid>
</Page>
