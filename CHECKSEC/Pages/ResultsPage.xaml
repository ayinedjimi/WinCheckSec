<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CHECKSEC.Pages.ResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.UI.Controls"
    NavigationCacheMode="Required"
    Loaded="OnLoaded">

    <Grid Padding="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE9F9;" FontSize="24" Foreground="{StaticResource AccentBlueBrush}"/>
                <TextBlock Text="Résultats Sécurité" Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OnExportExcel" ToolTipService.ToolTip="Exporter Excel"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                        AutomationProperties.Name="Exporter au format Excel">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                        <TextBlock Text="Excel"/>
                    </StackPanel>
                </Button>
                <Button Click="OnExportPdf" ToolTipService.ToolTip="Exporter PDF"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                        AutomationProperties.Name="Exporter au format PDF">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEA90;" FontSize="14"/>
                        <TextBlock Text="PDF"/>
                    </StackPanel>
                </Button>
                <Button Click="OnExportCsv" ToolTipService.ToolTip="Exporter CSV"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                        AutomationProperties.Name="Exporter au format CSV">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        <TextBlock Text="CSV"/>
                    </StackPanel>
                </Button>
                <Button Click="OnCopyAll" ToolTipService.ToolTip="Copier tout"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                        AutomationProperties.Name="Copier tous les résultats">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Copier"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Export indicator -->
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsExporting, Mode=OneWay}"
                 IsClosable="False" Severity="Informational" Title="Exportation en cours…">
            <InfoBar.Content>
                <ProgressBar IsIndeterminate="True" Margin="0,0,0,4"/>
            </InfoBar.Content>
        </InfoBar>

        <!-- Summary bar + filters -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16,10"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Total" FontSize="11" Opacity="0.6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="{x:Bind ViewModel.OkCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}"/>
                    <TextBlock Text="OK" FontSize="11" Opacity="0.6"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                    <TextBlock Text="{x:Bind ViewModel.WarningCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource StatusOrangeBrush}"/>
                    <TextBlock Text="Avertissements" FontSize="11" Opacity="0.6"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,20,0">
                    <TextBlock Text="{x:Bind ViewModel.CriticalCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource StatusRedBrush}"/>
                    <TextBlock Text="Critiques" FontSize="11" Opacity="0.6"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,20,0">
                    <TextBlock Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Opacity="0.5"/>
                    <TextBlock Text="Erreurs" FontSize="11" Opacity="0.6"/>
                </StackPanel>

                <ComboBox Grid.Column="5" x:Name="StatusFilter" Header="Filtrer" Width="150"
                          AutomationProperties.Name="Filtrer par statut"
                          SelectionChanged="OnFilterChanged" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="Tous"/>
                    <ComboBoxItem Content="OK"/>
                    <ComboBoxItem Content="Warning"/>
                    <ComboBoxItem Content="Critical"/>
                    <ComboBoxItem Content="Error"/>
                </ComboBox>

                <AutoSuggestBox Grid.Column="6" x:Name="SearchBox" PlaceholderText="Rechercher..."
                                AutomationProperties.Name="Rechercher dans les résultats"
                                QueryIcon="Find" Width="250" TextChanged="OnSearchChanged"/>
            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="3" IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                     VerticalAlignment="Top" Margin="0,0,0,8"/>

        <!-- Empty state -->
        <TextBlock Grid.Row="3" Text="Lancez une analyse pour afficher les résultats."
                   Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToInverseVis}}"
                   Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>

        <!-- DataGrid -->
        <ctk:DataGrid Grid.Row="3"
                       x:Name="ResultsGrid"
                       ItemsSource="{x:Bind ViewModel.FilteredResults, Mode=OneWay}"
                       AutoGenerateColumns="False"
                       CanUserSortColumns="True"
                       CanUserReorderColumns="False"
                       Sorting="OnSorting"
                       IsReadOnly="True"
                       GridLinesVisibility="Horizontal"
                       AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                       RowHeight="38"
                       MaxHeight="800"
                       HeadersVisibility="Column"
                       Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
            <ctk:DataGrid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copier la ligne" Click="OnCopyRow">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Copier en JSON" Click="OnCopyRowJson">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE943;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Voir les détails" Click="OnViewDetails">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ctk:DataGrid.ContextFlyout>

            <ctk:DataGrid.Columns>
                <ctk:DataGridTextColumn Header="Statut" Binding="{Binding Status}" Tag="Status" Width="90"/>
                <ctk:DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Tag="Category" Width="160"/>
                <ctk:DataGridTextColumn Header="Vérification" Binding="{Binding CheckName}" Tag="CheckName" Width="250"/>
                <ctk:DataGridTextColumn Header="Actuel" Binding="{Binding CurrentValue}" Tag="CurrentValue" Width="150"/>
                <ctk:DataGridTextColumn Header="Attendu" Binding="{Binding ExpectedValue}" Tag="ExpectedValue" Width="150"/>
                <ctk:DataGridTextColumn Header="Description" Binding="{Binding Description}" Tag="Description" Width="*"/>
            </ctk:DataGrid.Columns>
        </ctk:DataGrid>
    </Grid>
</Page>
