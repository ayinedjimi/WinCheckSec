<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CHECKSEC.Pages.GapsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.UI.Controls"
    NavigationCacheMode="Required"
    Loaded="OnLoaded">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with export buttons -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7BA;" FontSize="24" Foreground="{StaticResource AccentBlueBrush}"/>
                    <TextBlock Text="Écarts MSCT — Conformité Sécurité" Style="{StaticResource TitleTextBlockStyle}"/>
                </StackPanel>
                <TextBlock Text="Écarts détectés par rapport aux baselines Microsoft Security Compliance Toolkit"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" Margin="36,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnExportExcel" ToolTipService.ToolTip="Exporter en Excel (.xlsx)"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}" Padding="12,8"
                        AutomationProperties.Name="Exporter au format Excel">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9F9;" FontSize="16"/>
                        <TextBlock Text="Excel" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Click="OnExportPdf" ToolTipService.ToolTip="Exporter en PDF"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}" Padding="12,8"
                        AutomationProperties.Name="Exporter au format PDF">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEA90;" FontSize="16"/>
                        <TextBlock Text="PDF" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Click="OnExportCsv" ToolTipService.ToolTip="Exporter en CSV"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}" Padding="12,8"
                        AutomationProperties.Name="Exporter au format CSV">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                        <TextBlock Text="CSV" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Click="OnCopyAll" ToolTipService.ToolTip="Copier tout"
                        IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}" Padding="12,8"
                        AutomationProperties.Name="Copier tous les écarts">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Copier" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Export indicator -->
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsExporting, Mode=OneWay}"
                 IsClosable="False" Severity="Informational" Title="Exportation en cours…">
            <InfoBar.Content>
                <ProgressBar IsIndeterminate="True" Margin="0,0,0,4"/>
            </InfoBar.Content>
        </InfoBar>

        <!-- Summary bar -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16,10" Margin="0,0,0,12"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource StatusRedBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13">
                            <Run Text="{x:Bind ViewModel.CriticalCount, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="Critiques"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource StatusRedBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13">
                            <Run Text="{x:Bind ViewModel.HighCount, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="Élevées"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource StatusOrangeBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13">
                            <Run Text="{x:Bind ViewModel.MediumCount, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="Moyennes"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource StatusGreenBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13">
                            <Run Text="{x:Bind ViewModel.LowCount, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="Faibles"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" FontSize="13" Opacity="0.5">
                        <Run Text="Total :"/>
                        <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="écarts"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="SeverityFilter" Header="Sévérité" Width="130"
                              AutomationProperties.Name="Filtrer par sévérité"
                              SelectedItem="{x:Bind ViewModel.FilterSeverity, Mode=TwoWay}"
                              SelectionChanged="OnFilterChanged">
                        <x:String>Toutes</x:String>
                        <x:String>Critical</x:String>
                        <x:String>High</x:String>
                        <x:String>Medium</x:String>
                        <x:String>Low</x:String>
                    </ComboBox>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Rechercher…" Width="220"
                                    AutomationProperties.Name="Rechercher dans les écarts"
                                    QueryIcon="Find" TextChanged="OnSearchChanged"
                                    VerticalAlignment="Bottom"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="3" IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                     VerticalAlignment="Top" Margin="0,0,0,8"/>

        <!-- Empty state -->
        <TextBlock Grid.Row="3" Text="Lancez une analyse pour afficher les écarts de conformité."
                   Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToInverseVis}}"
                   Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>

        <ctk:DataGrid Grid.Row="3"
                       x:Name="GapsGrid"
                       ItemsSource="{x:Bind ViewModel.Gaps, Mode=OneWay}"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserSortColumns="True"
                       CanUserReorderColumns="False"
                       CanUserResizeColumns="True"
                       GridLinesVisibility="Horizontal"
                       AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                       RowHeight="38"
                       MaxHeight="800"
                       HeadersVisibility="Column"
                       HorizontalScrollBarVisibility="Auto"
                       SelectionMode="Single"
                       Sorting="OnSorting"
                       Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
            <ctk:DataGrid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copier la ligne" Click="OnCopyRow">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Copier en JSON" Click="OnCopyRowJson">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE943;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Voir les détails" Click="OnViewDetails">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ctk:DataGrid.ContextFlyout>
            <ctk:DataGrid.Columns>
                <ctk:DataGridTemplateColumn Header="" Width="40" CanUserSort="False" CanUserResize="False">
                    <ctk:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                                     Fill="{Binding SeverityColorHex, Converter={StaticResource HexToBrush}}"/>
                        </DataTemplate>
                    </ctk:DataGridTemplateColumn.CellTemplate>
                </ctk:DataGridTemplateColumn>
                <ctk:DataGridTextColumn Header="Sévérité" Binding="{Binding Severity}" Width="100" Tag="Severity"/>
                <ctk:DataGridTextColumn Header="Politique" Binding="{Binding PolicyName}" Width="*" Tag="PolicyName"/>
                <ctk:DataGridTextColumn Header="Chemin registre" Binding="{Binding RegistryPath}" Width="220" Tag="RegistryPath"/>
                <ctk:DataGridTextColumn Header="Attendu" Binding="{Binding BaselineValue}" Width="110" Tag="BaselineValue"/>
                <ctk:DataGridTextColumn Header="Actuel" Binding="{Binding CurrentValue}" Width="110" Tag="CurrentValue"/>
                <ctk:DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="160" Tag="GpoName"/>
            </ctk:DataGrid.Columns>
        </ctk:DataGrid>
    </Grid>
</Page>
