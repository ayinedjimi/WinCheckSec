<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CHECKSEC.Controls.StatusDonutChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="200" Height="200">
        <Canvas x:Name="ChartCanvas" Width="200" Height="200"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="CenterText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CenterLabel" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
